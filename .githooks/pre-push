#!/bin/sh
# Необязательный хук: гейты изменённых зон перед push. Включить: git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1
if command -v py >/dev/null 2>&1; then
  PY=py
elif command -v python3 >/dev/null 2>&1; then
  PY=python3
else
  PY=python
fi
exec "$PY" tasks.py gate-changed
