# Скопируй в .env и заполни. Файл .env в git не попадает.

# Бэкенд
PORT=8080
BACKEND_URL=http://localhost:8080

# Общий секрет ML-воркера: он шлёт события в бэкенд с заголовком Authorization: Bearer <токен>.
# `py tasks.py run` создаёт его сам (~/.mosprom/worker_token); здесь нужен, только если воркер на другой машине.
WORKER_TOKEN=

# Файл пользователей (логин, роль, хеш пароля) вне git. Пусто — ~/.mosprom/users.json.
# Добавить: python -m app.cli add-user <login> <role> --name "…" (из папки backend/).
MOSPROM_USERS=

# Через сколько секунд без реакции мастера событие уходит выше по цепочке (эскалация). По умолчанию 60.
ESCALATE_S=60

# Доступ к LinQ (адрес стенда, логин, токен, VPN-профиль) выдают организаторы и задаются только
# локально в .env. Список полей и порядок подключения — docs/LINQ_SETUP.md.
